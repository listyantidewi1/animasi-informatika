{
 "workbench.colorTheme": "Default Dark Modern",
 "workbench.startupEditor": "none",
 "workbench.tips.enabled": false,
 "workbench.enableExperiments": false,
 "workbench.secondarySideBar.defaultVisibility": "hidden",
 "chat.commandCenter.enabled": false,
 "chat.disableAIFeatures": true,
 "security.workspace.trust.enabled": false,
 "telemetry.telemetryLevel": "off",
 "update.mode": "none",
 "extensions.ignoreRecommendations": true,
 "editor.fontSize": 20,
 "editor.lineHeight": 30,
 "editor.fontFamily": "'DejaVu Sans Mono', monospace",
 "editor.minimap.enabled": false,
 "editor.wordWrap": "on",
 "editor.autoClosingBrackets": "never",
 "editor.autoClosingQuotes": "never",
 "editor.autoClosingOvertype": "never",
 "editor.autoSurround": "never",
 "editor.autoIndent": "none",
 "editor.formatOnType": false,
 "editor.quickSuggestions": {
  "other": false,
  "comments": false,
  "strings": false
 },
 "editor.suggestOnTriggerCharacters": false,
 "editor.acceptSuggestionOnEnter": "off",
 "editor.parameterHints.enabled": false,
 "editor.wordBasedSuggestions": "off",
 "editor.inlineSuggest.enabled": false,
 "editor.hover.enabled": false,
 "editor.stickyScroll.enabled": false,
 "editor.renderWhitespace": "none",
 "html.autoClosingTags": false,
 "javascript.autoClosingTags": false,
 "terminal.integrated.fontSize": 20,
 "terminal.integrated.fontFamily": "'DejaVu Sans Mono', monospace",
 "files.autoSave": "off",
 "breadcrumbs.enabled": false,
 "window.commandCenter": false,
 "workbench.layoutControl.enabled": false,
 "git.enabled": true,
 "explorer.compactFolders": false,
 "terminal.integrated.profiles.linux": {
  "raka": {
   "path": "bash",
   "args": [
    "--rcfile",
    "/home/user/proyek/raka.rc"
   ],
   "icon": "account"
  },
  "nadia": {
   "path": "bash",
   "args": [
    "--rcfile",
    "/home/user/proyek/nadia.rc"
   ],
   "icon": "account"
  }
 },
 "terminal.integrated.defaultProfile.linux": "raka",
 "terminal.integrated.cwd": "/home/user/proyek/raka/siantre",
 "workbench.statusBar.visible": true,
 "window.title": "${rootName}",
 "terminal.integrated.enablePersistentSessions": false,
 "terminal.integrated.persistentSessionReviveProcess": "never",
 "terminal.integrated.tabs.enabled": true,
 "terminal.integrated.showExitAlert": false,
 "workbench.editor.enablePreview": false,
 "files.exclude": {
  "**/node_modules": true
 },
 "explorer.excludeGitIgnore": false,
 "scm.diffDecorations": "gutter",
 "merge-conflict.codeLens.enabled": true,
 "merge-conflict.decorators.enabled": true,
 "window.restoreWindows": "none",
 "files.hotExit": "off",
 "terminal.integrated.gpuAcceleration": "off",
 "workbench.panel.defaultLocation": "bottom",
 "git.autofetch": false,
 "git.openRepositoryInParentFolders": "never",
 "git.autoRepositoryDetection": true,
 "git.showProgress": false,
 "git.decorations.enabled": true,
 "git.confirmSync": false,
 "git.terminalAuthentication": false,
 "git.useIntegratedAskPass": false,
 "git.mergeEditor": false,
 "git.ignoreLegacyWarning": true,
 "git.ignoreMissingGitWarning": true,
 "keyboard.dispatch": "keyCode",
 "workbench.localHistory.enabled": false,
 "terminal.integrated.enableMultiLinePasteWarning": "never",
 "git.blame.statusBarItem.enabled": false,
 "git.blame.editorDecoration.enabled": false,
 "git.showActionButton": {
  "commit": false,
  "publish": false,
  "sync": false
 }
}