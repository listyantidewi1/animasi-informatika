# Sama dengan Dockerfile di video, ditambah sertifikat proxy lingkungan rekam (tidak ditampilkan)
FROM node:22-alpine
WORKDIR /app
ARG HTTPS_PROXY
ARG HTTP_PROXY
COPY package*.json ca-bundle.crt ./
RUN NODE_EXTRA_CA_CERTS=/app/ca-bundle.crt npm ci --omit=dev --cafile /app/ca-bundle.crt && rm -f ca-bundle.crt
COPY . .
ENV NODE_ENV=production
USER node
EXPOSE 3000
CMD ["node", "src/server.js"]
